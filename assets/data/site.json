---
layout: null
---
{
  "site": {
    "title": {{ site.title | jsonify }},
    "description": {{ site.description | jsonify }},
    "url": {{ site.url | jsonify }},
    "baseurl": {{ site.baseurl | jsonify }},
    "email": {{ site.email | jsonify }},
    "github_username": {{ site.github_username | jsonify }},
    "github_repo": {{ site.github_repo | jsonify }},
    "twitter_username": {{ site.twitter_username | jsonify }},
    "linkedin_username": {{ site.linkedin_username | jsonify }},
    "professional_url": {{ site.professional_url | jsonify }}
  },
  "tiles": [
    {%- assign sorted_tiles = site.tiles | sort: "order" -%}
    {%- assign first_tile = true -%}
    {%- for tile in sorted_tiles -%}
    {%- unless first_tile -%},{%- endunless -%}
    {
      "title": {{ tile.title | jsonify }},
      "url": {{ tile.url | jsonify }},
      "summary": {{ tile.summary | default: "" | jsonify }},
      "order": {{ tile.order | default: 0 | jsonify }},
      "markdown": {{ tile.raw_markdown | default: "" | jsonify }}
    }
    {%- assign first_tile = false -%}
    {%- endfor -%}
  ],
  "posts": [
    {%- assign first_post = true -%}
    {%- for post in site.posts -%}
    {%- unless first_post -%},{%- endunless -%}
    {
      "id": {{ post.id | jsonify }},
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }},
      "categories": {{ post.categories | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | strip | jsonify }},
      "markdown": {{ post.raw_markdown | default: "" | jsonify }}
    }
    {%- assign first_post = false -%}
    {%- endfor -%}
  ],
  "pages": [
    {%- assign first_page = true -%}
    {%- for page in site.pages -%}
    {%- if page.layout == "app" and page.title and page.url != "/" and page.url != "/tiles/" and page.url != "/404.html" -%}
    {%- unless first_page -%},{%- endunless -%}
    {
      "title": {{ page.title | jsonify }},
      "url": {{ page.url | jsonify }},
      "markdown": {{ page.raw_markdown | default: "" | jsonify }}
    }
    {%- assign first_page = false -%}
    {%- endif -%}
    {%- endfor -%}
  ]
}
